{
  "name": "vera-rapportage-assistent",
  "version": "0.1.0",
  "private": true,
  "description": "V.E.R.A. — Verslag- en Rapportage Assistent voor professionals in het publieke domein",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "eval": "node --env-file-if-exists=.env --import tsx scripts/eval-harness.ts",
    "purge:expired": "node --env-file-if-exists=.env --import tsx scripts/purge-expired.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.0",
    "bcryptjs": "^3.0.3",
    "docx": "^9.7.1",
    "jose": "^6.2.12",
    "mammoth": "^1.12.3",
    "next": "^16.3.5",
    "openai": "^7.15.0",
    "pg": "^8.23.0",
    "postcss": "^8.5.28",
    "prisma": "^7.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "tsx": "^4.23.13",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  }
}
