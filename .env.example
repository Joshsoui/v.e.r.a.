# ============================================================================
# V.E.R.A. — omgevingsvariabelen
# Kopieer dit bestand naar .env (lokaal) en vul de echte waarden in.
# Op Render vul je de sync:false-variabelen zelf in het dashboard in
# (zie README.md, hoofdstuk "Render deploymenthandleiding").
# ============================================================================

# --- Database (Supabase Postgres) ---------------------------------------
# Pooled/Supavisor-connectie (poort 6543) — gebruikt door de applicatie zelf.
# Haal deze op via Supabase → Project Settings → Database → Connection string
# → "Transaction pooler" en voeg ?pgbouncer=true toe.
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Directe connectie (poort 5432) — uitsluitend gebruikt door Prisma Migrate.
# Supabase → Project Settings → Database → Connection string → "Direct connection".
DIRECT_URL="postgresql://postgres:PASSWORD@db.xxxxx.supabase.co:5432/postgres"

# --- OpenAI ----------------------------------------------------------------
OPENAI_API_KEY="sk-..."
# Configureerbaar model; controleer of dit model nog actueel is en Structured
# Outputs (strict JSON schema) ondersteunt via de Responses API.
OPENAI_MODEL="gpt-4.1-mini"
OPENAI_TIMEOUT_MS="45000"
# Transcriptiemodel voor gespreksopnames (zie "Gespreksopnames" hieronder).
OPENAI_TRANSCRIBE_MODEL="gpt-4o-transcribe"

# --- Auth / sessies ----------------------------------------------------------
# Willekeurige, lange geheime string voor het ondertekenen van sessie-JWT's.
# Genereer bijvoorbeeld met: openssl rand -base64 48
AUTH_SECRET="vervang-mij-met-een-lange-willekeurige-string"
AUTH_COOKIE_NAME="vera_session"

# --- Applicatie ---------------------------------------------------------------
NODE_ENV="development"
# Basis-URL van de app (voor absolute links, cookies e.d.). Op Render hoeft dit
# niet ingevuld te worden: de app valt automatisch terug op RENDER_EXTERNAL_URL.
APP_BASE_URL="http://localhost:3000"

# --- Rate limiting -------------------------------------------------------------
RATE_LIMIT_AI_MAX="10"
RATE_LIMIT_AI_WINDOW_MS="3600000"
RATE_LIMIT_AUTH_MAX="10"
RATE_LIMIT_AUTH_WINDOW_MS="900000"
# Transcriptie is een betaalde externe API-aanroep per opname — apart
# gerate-limit t.o.v. de VERA-analyse zelf.
RATE_LIMIT_TRANSCRIBE_MAX="15"
RATE_LIMIT_TRANSCRIBE_WINDOW_MS="3600000"

# --- Upload / invoerlimieten -------------------------------------------------
MAX_UPLOAD_FILE_SIZE_BYTES="5000000"
# Audio is van nature veel groter dan tekst/.docx; 25 MB is ook de limiet van
# OpenAI's transcriptie-API zelf.
MAX_AUDIO_FILE_SIZE_BYTES="25000000"
MAX_SOURCE_FILES_PER_REPORT="10"
MAX_TOTAL_INPUT_CHARS="60000"

# --- Retentie (privacy-by-design) --------------------------------------------
# Aantal dagen dat dossierinhoud (bronnen, hoofdstukken) bewaard blijft voordat
# deze als verlopen wordt beschouwd en opgeruimd kan worden.
REPORT_RETENTION_DAYS="30"

# --- E-mail (wachtwoord-resetflow) -------------------------------------------
# Optioneel. Leeg = de resetlink wordt gelogd i.p.v. verstuurd (zie README,
# hoofdstuk 9). Maak een gratis account op resend.com voor een sleutel.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="V.E.R.A. <onboarding@resend.dev>"
